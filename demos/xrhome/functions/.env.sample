# XRHome Advanced Integration Environment Variables
# Copy this file to '.env' and populate with your credentials.

# ==========================================
# Home Assistant Cloud Integration
# ==========================================
# Your Home Assistant URL (e.g. Nabu Casa remote URL)
HA_URL=https://my-home.ui.nabu.casa

# Your Long-Lived Access Token generated in Home Assistant
HA_TOKEN=your_long_lived_access_token_here

# ==========================================
# Vertex AI / Gemini Integration (Vision/ML)
# ==========================================
# Your Gemini API Key used for spatial reasoning and Vision processing
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specific Vertex Vision endpoint if not using default Gemini
VERTEX_VISION_ENDPOINT=

# ==========================================
# Firebase Client Configuration (Auth/Web)
# ==========================================
# Your Firebase Web API Key for Google Sign-in to work from the browser
WEB_API_KEY=your_firebase_api_key_here

# ==========================================
# Firebase Cloud Functions Loading
# ==========================================
# Firebase will automatically load this .env file during deployment
# so you do not need to manually set secrets using the CLI.
# Simply run `firebase deploy --only functions` to push these environment variables.
